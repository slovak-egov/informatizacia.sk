<script language="javascript" type="text/javascript">

function check_date(oForm) {
	if (oForm) {
		var regex = /[0-9][0-9]\.[0-9][0-9]\.[0-9][0-9][0-9][0-9]$/;
		if ((oForm.sfrom.value != '') && !regex.test(oForm.sfrom.value)) {
			alert("Položka musí byť dátumom v tvare DD.MM.RRRR.");
			oForm.sfrom.focus();
			return false;
		}
		if ((oForm.sto.value != '') && !regex.test(oForm.sto.value)) {
			alert("Položka musí byť dátumom v tvare DD.MM.RRRR.");
			oForm.sto.focus();
			return false;
		}
	}
	return true;
}

</script>
